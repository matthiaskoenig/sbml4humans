# build stage
FROM node:24 AS build-stage
WORKDIR /app
COPY package*.json /app/
RUN npm ci
COPY . /app/
# the commit the footer links: the build context has no repository to read it from, so the build
# takes it as an argument. Without it the footer shows the version alone.
ARG VITE_COMMIT=""
ENV VITE_COMMIT=$VITE_COMMIT
RUN npm run build

# production stage: the static files are copied into the nginx volume
FROM alpine:3.22 AS production-stage
RUN mkdir -p /vue
COPY --from=build-stage /app/dist /vue

CMD ["tail", "-f", "/dev/null"]
