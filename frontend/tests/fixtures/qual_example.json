              {
                "pk": "qual_example/Transition:tr_P",
                "sbmlType": "Transition",
                "id": "tr_P",
                "metaId": null,
                "name": "synthesis of the protein",
                "sbo": null,
                "notes": "<notes>\n  <body xmlns=\"http://www.w3.org/1999/xhtml\">\n    <p>The protein is made while the gene is on and while it has not reached its highest level yet. The input consumes the gene, the way the firing of a Petri net transition takes the tokens of its places, and the output produces one level of protein for every result level of the term which fires.</p>\n  </body>\n</notes>",
                "cvterms": [],
                "history": null,
                "xml": "<qual:transition qual:id=\"tr_P\" qual:name=\"synthesis of the protein\">\n  <notes>\n    <body xmlns=\"http://www.w3.org/1999/xhtml\">\n      <p>The protein is made while the gene is on and while it has not reached its highest level yet. The input consumes the gene, the way the firing of a Petri net transition takes the tokens of its places, and the output produces one level of protein for every result level of the term which fires.</p>\n    </body>\n  </notes>\n  <qual:listOfInputs>\n    <qual:input qual:id=\"w_P_G\" qual:qualitativeSpecies=\"G\" qual:transitionEffect=\"consumption\" qual:name=\"weight of the gene\" qual:sign=\"positive\" qual:thresholdLevel=\"1\"/>\n    <qual:input qual:id=\"theta_P_P\" qual:qualitativeSpecies=\"P\" qual:transitionEffect=\"none\" qual:name=\"threshold of the protein\" qual:sign=\"negative\" qual:thresholdLevel=\"2\"/>\n  </qual:listOfInputs>\n  <qual:listOfOutputs>\n    <qual:output qual:id=\"out_P\" qual:qualitativeSpecies=\"P\" qual:transitionEffect=\"production\" qual:outputLevel=\"1\"/>\n  </qual:listOfOutputs>\n  <qual:listOfFunctionTerms>\n    <qual:defaultTerm qual:resultLevel=\"0\"/>\n    <qual:functionTerm qual:resultLevel=\"2\">\n      <math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n        <apply>\n          <and/>\n          <apply>\n            <geq/>\n            <ci> G </ci>\n            <ci> w_P_G </ci>\n          </apply>\n          <apply>\n            <eq/>\n            <ci> P </ci>\n            <cn type=\"integer\"> 0 </cn>\n          </apply>\n        </apply>\n      </math>\n    </qual:functionTerm>\n    <qual:functionTerm qual:resultLevel=\"1\">\n      <math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n        <apply>\n          <and/>\n          <apply>\n            <geq/>\n            <ci> G </ci>\n            <ci> w_P_G </ci>\n          </apply>\n          <apply>\n            <lt/>\n            <ci> P </ci>\n            <ci> theta_P_P </ci>\n          </apply>\n        </apply>\n      </math>\n    </qual:functionTerm>\n  </qual:listOfFunctionTerms>\n</qual:transition>",
