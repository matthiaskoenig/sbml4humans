              {
                "pk": "qual_example/Transition:tr_G",
                "sbmlType": "Transition",
                "id": "tr_G",
                "metaId": "meta_tr_G",
                "name": "expression of the gene",
                "sbo": null,
                "notes": "<notes>\n  <body xmlns=\"http://www.w3.org/1999/xhtml\">\n    <p>The gene is switched on by the signal and stays on while it is on, which is the hysteresis of the switch, and the protein switches it off once it reaches its highest level.</p>\n    <p>The two function terms are the two states in which the gene is on. Every state they do not cover is the default term, where the gene is off.</p>\n  </body>\n</notes>",
                "cvterms": [
                  {
                    "qualifier": "BQB_IS_VERSION_OF",
                    "resources": [
                      "https://identifiers.org/GO:0010468"
                    ],
                    "nested": []
                  }
                ],
                "history": null,
                "xml": "<qual:transition metaid=\"meta_tr_G\" qual:id=\"tr_G\" qual:name=\"expression of the gene\">\n  <notes>\n    <body xmlns=\"http://www.w3.org/1999/xhtml\">\n      <p>The gene is switched on by the signal and stays on while it is on, which is the hysteresis of the switch, and the protein switches it off once it reaches its highest level.</p>\n      <p>The two function terms are the two states in which the gene is on. Every state they do not cover is the default term, where the gene is off.</p>\n    </body>\n  </notes>\n  <annotation>\n    <rdf:RDF xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\" xmlns:bqbiol=\"http://biomodels.net/biology-qualifiers/\">\n      <rdf:Description rdf:about=\"#meta_tr_G\">\n        <bqbiol:isVersionOf>\n          <rdf:Bag>\n            <rdf:li rdf:resource=\"https://identifiers.org/GO:0010468\"/>\n          </rdf:Bag>\n        </bqbiol:isVersionOf>\n      </rdf:Description>\n    </rdf:RDF>\n  </annotation>\n  <qual:listOfInputs>\n    <qual:input qual:id=\"theta_G_S\" qual:qualitativeSpecies=\"S\" qual:transitionEffect=\"none\" qual:name=\"threshold of the signal\" qual:sign=\"positive\" qual:thresholdLevel=\"1\"/>\n    <qual:input qual:id=\"theta_G_P\" qual:qualitativeSpecies=\"P\" qual:transitionEffect=\"none\" qual:name=\"threshold of the protein\" qual:sign=\"negative\" qual:thresholdLevel=\"2\"/>\n    <qual:input qual:id=\"theta_G_G\" qual:qualitativeSpecies=\"G\" qual:transitionEffect=\"none\" qual:name=\"threshold of the gene\" qual:sign=\"positive\" qual:thresholdLevel=\"1\"/>\n  </qual:listOfInputs>\n  <qual:listOfOutputs>\n    <qual:output qual:id=\"out_G\" qual:qualitativeSpecies=\"G\" qual:transitionEffect=\"assignmentLevel\"/>\n  </qual:listOfOutputs>\n  <qual:listOfFunctionTerms>\n    <qual:defaultTerm qual:resultLevel=\"0\"/>\n    <qual:functionTerm qual:resultLevel=\"1\">\n      <math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n        <apply>\n          <and/>\n          <apply>\n            <geq/>\n            <ci> S </ci>\n            <ci> theta_G_S </ci>\n          </apply>\n          <apply>\n            <lt/>\n            <ci> P </ci>\n            <ci> theta_G_P </ci>\n          </apply>\n        </apply>\n      </math>\n    </qual:functionTerm>\n    <qual:functionTerm qual:resultLevel=\"1\">\n      <math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n        <apply>\n          <and/>\n          <apply>\n            <geq/>\n            <ci> G </ci>\n            <ci> theta_G_G </ci>\n          </apply>\n          <apply>\n            <lt/>\n            <ci> P </ci>\n            <ci> theta_G_P </ci>\n          </apply>\n        </apply>\n      </math>\n    </qual:functionTerm>\n  </qual:listOfFunctionTerms>\n</qual:transition>",
