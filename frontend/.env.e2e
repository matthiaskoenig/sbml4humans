# the build the end to end tests run against (npm run build:e2e, served by `vite preview` on
# port 4173): a production build, which serves its pages without transforming them on demand,
# talking to the backend of the tests on port 1444, and reporting nothing
VITE_API_URL=http://localhost:1444/api
VITE_DOCS_URL=https://matthiaskoenig.github.io/sbml4humans/
VITE_ANALYTICS=off
