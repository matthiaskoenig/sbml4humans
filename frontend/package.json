{
  "name": "sbml4humans",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "author": "Matthias König <konigmatt@googlemail.com> (https://livermetabolism.com)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:package": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode package --outDir ../backend/sbml4humans/resources/frontend --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "types": "json2ts --input src/schema/report.schema.json --output src/types/report.ts --additionalProperties false --bannerComment \"/* eslint-disable */\n// Generated by 'npm run types' from src/schema/report.schema.json, do not edit.\" && prettier --write src/types/report.ts",
    "fixtures": "node scripts/fixtures.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@lucide/vue": "^1.47.0",
    "dompurify": "^3.4.15",
    "katex": "^0.18.7",
    "markdown-it": "^15.0.2",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-gtag": "^3.7.1",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
