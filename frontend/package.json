{
  "name": "sbml4humans",
  "version": "0.12.2",
  "private": true,
  "type": "module",
  "author": "Matthias König <konigmatt@googlemail.com> (https://livermetabolism.com)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:package": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode package --outDir ../backend/sbml4humans/resources/frontend --emptyOutDir",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "types": "json2ts --input src/schema/report.schema.json --output src/types/report.ts --additionalProperties false --bannerComment \"/* eslint-disable */\n// Generated by 'npm run types' from src/schema/report.schema.json, do not edit.\" && json2ts --input src/schema/annotation.schema.json --output src/types/annotation.ts --additionalProperties false --bannerComment \"/* eslint-disable */\n// Generated by 'npm run types' from src/schema/annotation.schema.json, do not edit.\" && json2ts --input src/schema/validation.schema.json --output src/types/validation.ts --additionalProperties false --bannerComment \"/* eslint-disable */\n// Generated by 'npm run types' from src/schema/validation.schema.json, do not edit.\" && prettier --write src/types/report.ts src/types/annotation.ts src/types/validation.ts",
    "fixtures": "node scripts/fixtures.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@lucide/vue": "^1.67.0",
    "dompurify": "^3.4.17",
    "katex": "^0.18.10",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.4",
    "tm-grammars": "^1.32.22",
    "vue": "^3.5.44",
    "vue-gtag": "^3.7.1",
    "vue-router": "^5.4.0"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "js-beautify": {
      "glob": "^14.0.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
