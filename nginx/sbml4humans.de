# ------------------
# sbml4humans.de
# ------------------
# The proxy of sbml4humans.de: terminates https and forwards every request to the nginx container
# of docker-compose-production.yml, which serves the frontend and proxies /api to the backend.
# Needs the snippets /etc/nginx/snippets/ssl.conf (nginx/ssl.conf) and
# /etc/nginx/snippets/sbml4humans-security-headers.conf (nginx/security-headers.conf).
access_log /var/www/logs/sbml4humans.de_access.log;
error_log /var/www/logs/sbml4humans.de_error.log;

# The validations of one client, keyed by its address: the backend admits a few validations at a
# time for everyone (a running validation may take 60 s), so that one client cannot keep the
# admission busy for all others, it may have 2 validation requests open at a time and start 12 a
# minute, a burst of 12 at once. A request beyond is answered 429, which the frontend shows as busy.
# This proxy sees the address of the client; the nginx container behind it sees this proxy alone.
limit_req_zone $binary_remote_addr zone=sbml4humans_validation_rate:10m rate=12r/m;
limit_conn_zone $binary_remote_addr zone=sbml4humans_validation_open:10m;

server {
    listen 80;
    listen [::]:80;

    server_name sbml4humans.de www.sbml4humans.de;
    server_tokens off;

    # letsencrypt webroot authenticator, the renewal of the certificate depends on it
    location ^~ /.well-known/acme-challenge/ {
        root /usr/share/nginx/letsencrypt;
        default_type "text/plain";
    }

    # every other path redirects to https
    location / {
        return 301 https://sbml4humans.de$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name www.sbml4humans.de;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/sbml4humans.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sbml4humans.de/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/sbml4humans-security-headers.conf;

    return 301 https://sbml4humans.de$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name sbml4humans.de;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/sbml4humans.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sbml4humans.de/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/sbml4humans-security-headers.conf;

    client_max_body_size 100m;
    proxy_connect_timeout       900;
    proxy_send_timeout          900;
    proxy_read_timeout          900;
    send_timeout                900;

    # http/1.1 to the container, whose gzip compresses http/1.1 requests only; the compressed
    # responses and their Cache-Control pass through unchanged. Every location inherits these.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    port_in_redirect off;

    location / {
        # denbi-cloud: node2, the nginx container of docker-compose-production.yml
        proxy_pass http://192.168.0.132:8084;
    }

    # the validations, limited per client (the zones at the top); with http/2 every request
    # counts as a connection of limit_conn
    location /api/validation/ {
        limit_req zone=sbml4humans_validation_rate burst=12 nodelay;
        limit_req_status 429;
        limit_conn sbml4humans_validation_open 2;
        limit_conn_status 429;
        proxy_pass http://192.168.0.132:8084;
    }
}
